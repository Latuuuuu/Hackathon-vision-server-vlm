# Copy to .env on the deploy host. .env is gitignored and survives deploys.

# Folder holding locate-anything-q8_0.gguf (and sam2.1_hiera_tiny.pt for mask mode).
# Hackathon-gpu: /home/wildbot/Documents/vlm
LOCATE_MODELS_DIR=/home/wildbot/Documents/vlm

# Locate decoding mode: fast (default, ~1.9 s on 640x362) | hybrid | slow.
# Use hybrid when many same-class objects can be in frame; clients then need timeout_s 12.0.
# LA_MODE=fast

# 1 = also run SAM2 and attach a mask PNG (~0.6 s extra per request).
# VLM_RETURN_MASK=0

# Description loaded at startup, so a restart does not leave the server in NO_QUERY.
# VLM_INITIAL_QUERY="the white paper cup"
